{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "collect",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html", "**/*.css", "**/*.client.js"],
      "fallthrough": true
    }
  ],

  // After Cloudflare creates or locates the real D1 database, add the same
  // binding block to BOTH runtime configs. Never invent a database_id.
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "scovion-analytics",
  //     "database_id": "<actual value returned by Cloudflare>",
  //     "migrations_dir": "migrations"
  //   }
  // ],

  "vars": {
    "COLLECT_HOST": "collect.pinghao-wang.workers.dev",
    "ADMIN_HOST": "analytics.pinghao-wang.workers.dev",
    "ALLOWED_ORIGINS": "https://www.scovion.com,https://scovion.com",
    "IP_RETENTION_DAYS": "30",
    "EVENT_RETENTION_DAYS": "30",
    "AGGREGATE_RETENTION_DAYS": "395"
  },
  "observability": {
    "enabled": true
  }
}
